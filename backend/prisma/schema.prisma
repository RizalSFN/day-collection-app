generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  username   String   @db.VarChar(255)
  email      String   @unique(map: "email") @db.VarChar(255)
  password   String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model products {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(150)
  slug        String          @db.VarChar(150)
  description String          @db.Text
  main_image  String          @db.VarChar(255)
  base_price  Decimal         @db.Decimal(10, 2)
  weight      Int             @default(1000)
  status      products_status
  created_at  DateTime        @default(now()) @db.Timestamp(0)
  updated_at  DateTime        @default(now()) @db.Timestamp(0)

  marketplace_link marketplace_link[]
  product_gallery  product_gallery[]
  orders           order[]
  product_variants product_variants[]
  orderItems       order_items[]
}

enum orderStatus {
  PENDING
  WAITING_PAYMENT
  WAITING_VERIFICATION
  PAID
  CANCELLED
}

enum checkoutMethod {
  MARKETPLACE
  BANK_TRANSFER
}

model order {
  id               Int            @id @default(autoincrement())
  order_code       String         @unique
  buyer_name       String
  buyer_phone      String
  buyer_address    String         @db.Text
  total_amount     Int
  checkout_method  checkoutMethod
  product_id       Int
  status           orderStatus    @default(PENDING)
  payment_proof    payment_proof?
  shipping_cost    Int            @default(0)
  shipping_courier String?
  shipping_service String?

  product      products @relation(fields: [product_id], references: [id])
  paymentProof String?

  created_at DateTime @default(now())
  update_at  DateTime @updatedAt

  items order_items[]
}

model order_items {
  id         Int  @id @default(autoincrement())
  order_id   Int
  product_id Int
  variant_id Int?
  quantity   Int
  price      Int

  order            order             @relation(fields: [order_id], references: [id])
  product          products          @relation(fields: [product_id], references: [id])
  product_variants product_variants? @relation(fields: [variant_id], references: [id])
}

model payment_proof {
  id          Int       @id @default(autoincrement())
  order_id    Int       @unique
  image_url   String
  uploaded_at DateTime  @default(now())
  verified_at DateTime?

  order order @relation(fields: [order_id], references: [id])
}

model product_variants {
  id         Int     @id @default(autoincrement())
  product_id Int
  color      String
  size       String
  price      Int?
  stock      Int
  is_active  Boolean @default(true)

  product     products      @relation(fields: [product_id], references: [id])
  order_items order_items[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model banner {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(100)
  image_url  String   @db.VarChar(255)
  is_active  Boolean
  created_at DateTime @default(now()) @db.Timestamp(0)
}

model marketplace_link {
  id                   Int                  @id @default(autoincrement())
  product_id           Int
  platform_id          Int
  url                  String               @db.Text
  is_active            Boolean
  created_at           DateTime             @default(now()) @db.Timestamp(0)
  products             products             @relation(fields: [product_id], references: [id], onUpdate: Restrict, onDelete: Cascade, map: "marketplace_link_ibfk_1")
  marketplace_platform marketplace_platform @relation(fields: [platform_id], references: [id], onUpdate: Restrict, map: "marketplace_link_ibfk_2")

  @@index([platform_id], map: "platform_id")
  @@index([product_id], map: "product_id")
}

model marketplace_platform {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(100)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  marketplace_link marketplace_link[]
}

model product_gallery {
  id         Int      @id @default(autoincrement())
  product_id Int
  image_url  String   @db.VarChar(255)
  alt_text   String   @db.VarChar(150)
  sort_order Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  products   products @relation(fields: [product_id], references: [id], onUpdate: Restrict, onDelete: Cascade, map: "product_gallery_ibfk_1")

  @@index([product_id], map: "product_id")
}

model settings {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  value      String   @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

enum products_status {
  active
  inactive
}
